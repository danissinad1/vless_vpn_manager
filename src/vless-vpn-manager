def main():
    parser = argparse.ArgumentParser(description="Интерактивная настройка VLESS VPN")
    group = parser.add_mutually_exclusive_group()
    group.add_argument("--diagnose", action="store_true")
    group.add_argument("--test", action="store_true")
    group.add_argument("--apply", action="store_true")
    group.add_argument("--repair", action="store_true")
    group.add_argument("--clean-install", action="store_true")
    group.add_argument("--cleanup", action="store_true")
    group.add_argument("--list", action="store_true")
    group.add_argument("--self-test", action="store_true")
    args = parser.parse_args()
    LOCK_FILE.parent.mkdir(parents=True, exist_ok=True)
    with LOCK_FILE.open("w") as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError as exc:
            raise RuntimeError("менеджер уже запущен в другом терминале; завершите тот сеанс и повторите") from exc
        if args.diagnose: diagnostics()
        elif args.test: test_nodes()
        elif args.apply: apply_best(interactive=False)
        elif args.repair: repair_installation()
        elif args.clean_install: clean_install()
        elif args.cleanup: full_cleanup()
        elif args.list: list_links()
        elif args.self_test: self_test()
        else: menu()


if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        print("\nОтменено")
        raise SystemExit(130)
    except Exception as exc:
        fail(str(exc))
        raise SystemExit(1)
