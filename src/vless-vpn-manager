def run(cmd, check=False, timeout=60):
    result = subprocess.run(cmd, text=True, capture_output=True, timeout=timeout)
    if check and result.returncode:
        detail = (result.stderr or result.stdout).strip()
        raise RuntimeError(f"{' '.join(cmd)}: {detail or 'код ' + str(result.returncode)}")
    return result


def require_root():
    if os.geteuid() != 0:
        raise RuntimeError("запустите скрипт от root: sudo vless-vpn-manager")


def load_core():
    if not CORE.is_file():
        raise RuntimeError(f"не найден модуль генерации {CORE}")
    return importlib.machinery.SourceFileLoader("vless_vpn_core", str(CORE)).load_module()


def protocol_name(item, kind=None):
    if kind == "xhttp" or item.get("transport") == "xhttp":
        return "XHTTP/TLS"
    if item.get("security") == "reality":
        return "Reality/TCP"
    return "TLS/TCP"


def summarize_uri(raw):
    uri = urlparse(raw.strip())
    q = parse_qs(uri.query)
    security = q.get("security", [""])[0].lower()
    transport = q.get("type", ["tcp"])[0].lower()
    if transport == "raw":
        transport = "tcp"
    if uri.scheme.lower() != "vless" or not uri.hostname or not uri.port or not uri.username:
        raise ValueError("неполная VLESS-ссылка")
    if transport == "xhttp" and security == "tls":
        proto = "XHTTP/TLS"
    elif transport == "tcp" and security == "reality":
        if not q.get("pbk", [""])[0]:
            raise ValueError("Reality без pbk")
        proto = "Reality/TCP"
    elif transport == "tcp" and security == "tls":
        proto = "TLS/TCP"
    else:
        raise ValueError(f"неподдерживаемая комбинация {security}/{transport}")
    return proto, uri.hostname, uri.port


