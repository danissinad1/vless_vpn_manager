def safe_input(prompt=""):
    """Read terminal bytes safely after partial UTF-8 backspace edits."""
    stream = getattr(sys.stdin, "buffer", None)
    if stream is None:
        return input(prompt)
    print(prompt, end="", flush=True)
    raw = stream.readline()
    if raw == b"":
        raise EOFError
    # In canonical TTY mode Backspace may remove only one byte of a
    # two-byte Cyrillic character. Ignore only the orphaned invalid byte.
    return raw.decode("utf-8", errors="ignore").rstrip("\r\n")


