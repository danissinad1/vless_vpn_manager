    ensure_session_backup()
    SOURCE.parent.mkdir(parents=True, exist_ok=True)
    if not SOURCE.exists():
        SOURCE.touch(mode=0o600)
        try:
            uid = int(run(["id", "-u", "odmin"], check=True).stdout)
            gid = int(run(["id", "-g", "odmin"], check=True).stdout)
            os.chown(SOURCE, uid, gid)
        except Exception:
            pass
    SING_CONFIG.parent.mkdir(parents=True, exist_ok=True)
    if not SING_CONFIG.exists():
        SING_CONFIG.write_text(json.dumps(base_sing_config(), ensure_ascii=False, indent=2) + "\n")
        os.chmod(SING_CONFIG, 0o600)
    XRAY_CONFIG.parent.mkdir(parents=True, exist_ok=True)
    if not XRAY_CONFIG.exists():
        XRAY_CONFIG.write_text(json.dumps({"log": {"loglevel": "warning"}, "inbounds": [], "outbounds": [], "routing": {"domainStrategy": "AsIs", "rules": []}}, indent=2) + "\n")
        os.chmod(XRAY_CONFIG, 0o600)
    unit = """[Unit]\nDescription=Xray SOCKS for Hermes\nAfter=network-online.target\nWants=network-online.target\n\n[Service]\nDynamicUser=yes\nLoadCredential=config.json:/etc/xray-hermes/config.json\nExecStart=/usr/local/bin/xray-hermes run -c %d/config.json\nRestart=on-failure\nRestartSec=2\n\n[Install]\nWantedBy=multi-user.target\n"""
    if not XRAY_UNIT.exists() or XRAY_UNIT.read_text() != unit:
        if XRAY_UNIT.exists():
            stamp = dt.datetime.now().strftime("%Y%m%d-%H%M%S")
            shutil.copy2(XRAY_UNIT, XRAY_UNIT.with_name(f"{XRAY_UNIT.name}.bak-{stamp}"))
        XRAY_UNIT.write_text(unit)
    run(["systemctl", "daemon-reload"], check=True)
    run(["systemctl", "enable", "sing-box.service", "xray-hermes.service"], check=True)
    ok("базовая конфигурация и автозапуск подготовлены")
    diagnostics()


def create_full_backup(label):
    """Archive VPN state and user links before destructive operations."""
    require_root()
    BACKUP_DIR.mkdir(parents=True, exist_ok=True)
    os.chmod(BACKUP_DIR, 0o700)
    stamp = dt.datetime.now().strftime("%Y%m%d-%H%M%S")
    archive = BACKUP_DIR / f"{label}-{stamp}.tar.gz"
    candidates = [
        SOURCE, SING_CONFIG.parent, XRAY_CONFIG.parent, XRAY_UNIT,
        STATE_DIR, Path("/var/lib/sing-box"), Path("/usr/local/bin/xray-hermes"),
        CORE,
    ]
    package = run(["dpkg-query", "-W", "-f=${Status}|${Version}", "sing-box"])
    package_fields = package.stdout.strip().split("|", 1)
    package_installed = package.returncode == 0 and package_fields[0] == "install ok installed"
    sing_active, sing_enabled = service_state("sing-box.service")
    xray_active, xray_enabled = service_state("xray-hermes.service")
    metadata = {
        "created_at": dt.datetime.now(dt.timezone.utc).isoformat(),
        "label": label,
        "paths_present": [str(path) for path in candidates if path.exists()],
        "sing_box_package": {"installed": package_installed, "version": package_fields[1] if package_installed and len(package_fields) > 1 else None},
        "services": {
            "sing-box.service": {"active": sing_active == "active", "enabled": sing_enabled == "enabled"},
            "xray-hermes.service": {"active": xray_active == "active", "enabled": xray_enabled == "enabled"},
        },
    }
    with tarfile.open(archive, "w:gz") as tar:
        for path in candidates:
            if path.exists():
                tar.add(path, arcname=str(path).lstrip("/"), recursive=True)
    os.chmod(archive, 0o600)
    metadata_path = Path(str(archive) + ".json")
    metadata_path.write_text(json.dumps(metadata, ensure_ascii=False, indent=2) + "\n")
    os.chmod(metadata_path, 0o600)
    ok(f"создана резервная копия: {archive}")
    return archive


def ensure_session_backup():
    """Create one immutable snapshot immediately before the first mutation."""
    global SESSION_BACKUP
    if SESSION_BACKUP is None:
        SESSION_BACKUP = create_full_backup("session-start")
        info("снимок состояния до изменений сохранён; доступен пункт отката")
    return SESSION_BACKUP


def remove_managed_paths():
    for path in [SING_CONFIG.parent, XRAY_CONFIG.parent, STATE_DIR, Path("/var/lib/sing-box")]:
        if path.exists():
            shutil.rmtree(path)
    for path in [XRAY_UNIT, Path("/usr/local/bin/xray-hermes"), SOURCE, CORE]:
        path.unlink(missing_ok=True)


def rollback_session():
    """Restore files, package and service state from before this manager session."""
    require_root()
    heading("ОТКАТ ИЗМЕНЕНИЙ ТЕКУЩЕГО ЗАПУСКА")
    if SESSION_BACKUP is None:
        warn("в текущем запуске ещё не выполнялись изменения — откатывать нечего")
        return
    print(f"Будет восстановлен снимок: {SESSION_BACKUP}")
    if safe_input("Откатить все изменения этого запуска? [y/N]: ").strip().lower() not in {"y", "yes", "д", "да"}:
        warn("откат отменён")
        return
    safety = create_full_backup("before-session-rollback")
    metadata_path = Path(str(SESSION_BACKUP) + ".json")
    if not metadata_path.exists():
        raise RuntimeError(f"отсутствуют метаданные снимка: {metadata_path}")
    metadata = json.loads(metadata_path.read_text())
    try:
        run(["systemctl", "stop", "sing-box.service", "xray-hermes.service"])
        package = metadata["sing_box_package"]
        current = run(["dpkg-query", "-W", "-f=${Status}|${Version}", "sing-box"])
        current_installed = current.returncode == 0 and current.stdout.startswith("install ok installed|")
        current_version = current.stdout.strip().split("|", 1)[1] if current_installed else None
        if package["installed"] and current_version != package["version"]:
            run(["apt-get", "update"], check=True, timeout=300)
            install = run(["apt-get", "install", "-y", "--allow-downgrades", f"sing-box={package['version']}"], timeout=300)
            if install.returncode:
                raise RuntimeError(f"не удалось вернуть sing-box {package['version']}: {(install.stderr or install.stdout).strip()}")
        elif not package["installed"] and current_installed:
            run(["apt-get", "purge", "-y", "sing-box"], check=True, timeout=300)
        remove_managed_paths()
        restore_backup(SESSION_BACKUP, restore_service_state=False)
        run(["systemctl", "daemon-reload"], check=True)
        for service, state in metadata["services"].items():
            if state["enabled"]:
                run(["systemctl", "enable", service], check=True)
            else:
                run(["systemctl", "disable", service])
            if state["active"]:
                run(["systemctl", "restart", service], check=True)
            else:
                run(["systemctl", "stop", service])
        missing = [path for path in metadata["paths_present"] if not Path(path).exists()]
        if missing:
            raise RuntimeError("после отката отсутствуют: " + ", ".join(missing))
        ok("все изменения текущего запуска отменены")
        info(f"страховочная копия состояния перед откатом: {safety}")
    except Exception:
        fail(f"откат не завершён; текущее состояние сохранено в {safety}")
        raise


def restore_backup(archive, restore_service_state=True):
    """Restore only an archive created by create_full_backup."""
    with tarfile.open(archive, "r:gz") as tar:
        members = tar.getmembers()
        if any(m.name.startswith("/") or ".." in Path(m.name).parts for m in members):
            raise RuntimeError("небезопасные пути в backup")
        tar.extractall("/")
    run(["systemctl", "daemon-reload"])
    if restore_service_state:
        run(["systemctl", "enable", "sing-box.service", "xray-hermes.service"])
        run(["systemctl", "restart", "xray-hermes.service", "sing-box.service"])


def install_xray_latest():
    arch_map = {"x86_64": "64", "amd64": "64", "aarch64": "arm64-v8a", "arm64": "arm64-v8a"}
    machine = os.uname().machine
    asset_arch = arch_map.get(machine)
    if not asset_arch:
        raise RuntimeError(f"автоустановка Xray не поддерживает архитектуру {machine}")
    api = "https://api.github.com/repos/XTLS/Xray-core/releases/latest"
    request = urllib.request.Request(api, headers={"User-Agent": "vless-vpn-manager"})
    with urllib.request.urlopen(request, timeout=30) as response:
        release = json.load(response)
    zip_name = f"Xray-linux-{asset_arch}.zip"
    urls = {asset["name"]: asset["browser_download_url"] for asset in release.get("assets", [])}
    if zip_name not in urls or zip_name + ".dgst" not in urls:
        raise RuntimeError(f"в релизе {release.get('tag_name')} нет {zip_name} или checksum")
    with tempfile.TemporaryDirectory(prefix="xray-install-") as tmp_name:
        tmp = Path(tmp_name)
        archive = tmp / zip_name
        digest_file = tmp / (zip_name + ".dgst")
        urllib.request.urlretrieve(urls[zip_name], archive)
        urllib.request.urlretrieve(urls[zip_name + ".dgst"], digest_file)
        match = re.search(r"SHA2-256=\s*([0-9a-fA-F]{64})", digest_file.read_text())
        if not match:
            raise RuntimeError("в checksum-файле Xray отсутствует SHA2-256")
        import hashlib
        actual = hashlib.sha256(archive.read_bytes()).hexdigest()
        if actual.lower() != match.group(1).lower():
            raise RuntimeError("SHA256 архива Xray не совпадает")
        with zipfile.ZipFile(archive) as zip_file:
            member = next((x for x in zip_file.namelist() if Path(x).name == "xray"), None)
            if not member:
                raise RuntimeError("в архиве Xray отсутствует бинарник")
            extracted = Path(zip_file.extract(member, tmp))
        Path("/usr/local/bin").mkdir(parents=True, exist_ok=True)
        shutil.copy2(extracted, "/usr/local/bin/xray-hermes")
        os.chmod("/usr/local/bin/xray-hermes", 0o755)
    ok(f"Xray {release.get('tag_name')} установлен, SHA256 проверен")


def write_clean_base(keep_links=True):
    """Create deterministic configs and unit without prompting."""
    if not keep_links or not SOURCE.exists():
        SOURCE.parent.mkdir(parents=True, exist_ok=True)
        SOURCE.touch(mode=0o600, exist_ok=True)

    SING_CONFIG.parent.mkdir(parents=True, exist_ok=True)
    SING_CONFIG.write_text(json.dumps(base_sing_config(), ensure_ascii=False, indent=2) + "\n")
    os.chmod(SING_CONFIG, 0o600)
    XRAY_CONFIG.parent.mkdir(parents=True, exist_ok=True)
    XRAY_CONFIG.write_text(json.dumps({"log": {"loglevel": "warning"}, "inbounds": [], "outbounds": [], "routing": {"domainStrategy": "AsIs", "rules": []}}, indent=2) + "\n")
    os.chmod(XRAY_CONFIG, 0o600)
    unit = """[Unit]\nDescription=Xray SOCKS for Hermes\nAfter=network-online.target\nWants=network-online.target\n\n[Service]\nDynamicUser=yes\nLoadCredential=config.json:/etc/xray-hermes/config.json\nExecStart=/usr/local/bin/xray-hermes run -c %d/config.json\nRestart=on-failure\nRestartSec=2\n\n[Install]\nWantedBy=multi-user.target\n"""
    XRAY_UNIT.parent.mkdir(parents=True, exist_ok=True)
    XRAY_UNIT.write_text(unit)
    run(["systemctl", "daemon-reload"], check=True)
    run(["systemctl", "enable", "sing-box.service", "xray-hermes.service"], check=True)


def full_cleanup():
    """Remove VPN services/data, retaining this manager and core installer."""
    require_root()
    heading("ПОЛНОЕ УДАЛЕНИЕ VPN")
    print("Будут остановлены и удалены:")
    print("  • sing-box package и его конфигурация/state")
    print("  • xray-hermes unit, бинарник и конфигурация")
    print("  • VLESS-ссылки и результаты тестов")
    print("Менеджер и core-установщик останутся для последующей чистой установки.")
    if not confirm_phrase("VPN немедленно перестанет работать. Данные будут доступны только в backup.", "УДАЛИТЬ VPN"):
        warn("полное удаление отменено")
        return
    ensure_session_backup()
    archive = create_full_backup("before-cleanup")
    run(["systemctl", "disable", "--now", "sing-box.service", "xray-hermes.service"])
    apt = run(["apt-get", "purge", "-y", "sing-box"], timeout=300)
    if apt.returncode:
        warn("apt purge sing-box завершился с ошибкой: " + (apt.stderr or apt.stdout).strip())
    for path in [SING_CONFIG.parent, XRAY_CONFIG.parent, STATE_DIR, Path("/var/lib/sing-box")]:
        if path.exists():
            shutil.rmtree(path)
    for path in [XRAY_UNIT, Path("/usr/local/bin/xray-hermes"), SOURCE]:
        path.unlink(missing_ok=True)
    run(["systemctl", "daemon-reload"])
    run(["systemctl", "reset-failed"])
    remaining = [p for p in [SING_CONFIG, XRAY_CONFIG, XRAY_UNIT, Path("/usr/local/bin/xray-hermes"), SOURCE] if p.exists()]
    if remaining:
        raise RuntimeError("не все объекты удалены: " + ", ".join(map(str, remaining)))
    ok("VPN-сервисы и данные полностью удалены")
    info(f"резервная копия: {archive}")


def clean_install():
    """Reinstall binaries/configs and apply links using strict health policy."""
    require_root()
    heading("ЧИСТАЯ УСТАНОВКА VPN")
    print("Операция остановит VPN, переустановит sing-box/Xray и пересоздаст конфиги.")
    print("Существующие VLESS-ссылки будут сохранены и повторно проверены.")
    if not confirm_phrase("Во время установки будет временный разрыв VPN.", "ЧИСТАЯ УСТАНОВКА"):
        warn("чистая установка отменена")
        return
    ensure_session_backup()
    archive = create_full_backup("before-clean-install")
    try:
        run(["systemctl", "stop", "sing-box.service", "xray-hermes.service"])
        info("установка/обновление sing-box из настроенного APT-репозитория")
        run(["apt-get", "update"], check=True, timeout=300)
        run(["apt-get", "install", "-y", "--reinstall", "sing-box", "ca-certificates", "curl", "unzip"], check=True, timeout=300)
        install_xray_latest()
        if not CORE.exists():
            raise RuntimeError(f"отсутствует обязательный core-установщик {CORE}")
        if SING_CONFIG.parent.exists():
            shutil.rmtree(SING_CONFIG.parent)
        if XRAY_CONFIG.parent.exists():
            shutil.rmtree(XRAY_CONFIG.parent)
        write_clean_base(keep_links=True)
        raw_links = [x for x in source_lines() if x.strip() and not x.strip().startswith("#")]
        if raw_links:
            apply_best(interactive=False)
        else:
            run(["systemctl", "enable", "--now", "sing-box.service", "xray-hermes.service"], check=True)
            warn("VLESS-ссылок нет: запущена базовая конфигурация без VPN")
        diagnostics()
        ok("чистая установка завершена и проверена")
    except Exception:
        fail("чистая установка не завершена; восстанавливаю предыдущую конфигурацию")
        try:
            restore_backup(archive)
            ok("предыдущая конфигурация восстановлена")
        except Exception as restore_error:
            fail(f"автооткат не выполнен: {restore_error}; backup: {archive}")
        raise


def verify_runtime(expected=None):
    for service in ("sing-box.service", "xray-hermes.service"):
        active = run(["systemctl", "is-active", service]).stdout.strip()
        if active != "active":
            raise RuntimeError(f"{service} не active: {active}")
    status = run(["curl", "--noproxy", "*", "--http2", "--connect-timeout", "7", "--max-time", "15", "-sS", "-o", "/dev/null", "-w", "%{http_code}", CHATGPT_URL]).stdout.strip()
    if status != EXPECTED_CHATGPT:
        raise RuntimeError(f"Codex API после применения: HTTP {status}")
    if expected is not None:
        config = json.loads(SING_CONFIG.read_text())
        selector = next((x for x in config.get("outbounds", []) if x.get("tag") == "vpn-auto"), None)
        actual = len(selector.get("outbounds", [])) if selector else 0
        if actual != expected:
            raise RuntimeError(f"в vpn-auto {actual} узлов вместо {expected}")


