def self_test():
    core = load_core()
    assert summarize_uri("vless://u@example.com:443?security=tls&type=tcp")[0] == "TLS/TCP"
    assert summarize_uri("vless://u@example.com:443?security=tls&type=xhttp")[0] == "XHTTP/TLS"
    try:
        summarize_uri("https://example.com")
        raise AssertionError("invalid URI accepted")
    except ValueError:
        pass
    native, xhttp, skipped = core.parse_links()
    sing, xray = core.build_configs(native[:1], xhttp[:1])
    assert any(x.get("tag") == "vpn-auto" for x in sing["outbounds"])
    assert all(o.get("streamSettings", {}).get("sockopt", {}).get("mark") == 0x2024 for o in xray["outbounds"])
    ok("self-test пройден")


