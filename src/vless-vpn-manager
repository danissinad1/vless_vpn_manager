def backup_source():
    if not SOURCE.exists():
        return None
    stamp = dt.datetime.now().strftime("%Y%m%d-%H%M%S")
    backup = SOURCE.with_name(f"{SOURCE.name}.bak-{stamp}")
    shutil.copy2(SOURCE, backup)
    return backup


def write_source(lines):
    require_root()
    SOURCE.parent.mkdir(parents=True, exist_ok=True)
    old_stat = SOURCE.stat() if SOURCE.exists() else None
    backup = backup_source()
    fd, name = tempfile.mkstemp(prefix=".remnawave.", dir=SOURCE.parent, text=True)
    tmp = Path(name)
    try:
        with os.fdopen(fd, "w") as fh:
            fh.write("\n".join(lines).rstrip() + "\n")
            fh.flush()
            os.fsync(fh.fileno())
        if old_stat:
            os.chown(tmp, old_stat.st_uid, old_stat.st_gid)
            os.chmod(tmp, old_stat.st_mode & 0o777)
        else:
            user = shutil.which("id") and run(["id", "-u", "odmin"]).stdout.strip()
            group = shutil.which("id") and run(["id", "-g", "odmin"]).stdout.strip()
            if user and group:
                os.chown(tmp, int(user), int(group))
            os.chmod(tmp, 0o600)
        os.replace(tmp, SOURCE)
    finally:
        tmp.unlink(missing_ok=True)
    return backup


def list_links():
    heading("VLESS-СЕРВЕРЫ")
    lines = source_lines()
    print("\nСтрока  Протокол       Сервер")
    print("------  -------------  ----------------------------------------")
    count = 0
    unique = 0
    duplicates = 0
    seen = {}
    for number, raw in enumerate(lines, 1):
        text = raw.strip()
        if not text or text.startswith("#"):
            continue
        count += 1
        if text in seen:
            duplicates += 1
            print(f"{number:>6}  {color('ДУБЛИКАТ', C_YELLOW):<13}  повтор строки {seen[text]}")
            continue
        seen[text] = number
        unique += 1
        try:
            proto, host, port = summarize_uri(text)
            print(f"{number:>6}  {color(proto, C_GREEN):<13}  {host}:{port}")
        except Exception as exc:
            print(f"{number:>6}  {'ОШИБКА':<13}  {exc}")
    print(f"\nНепустых записей: {count}; уникальных: {unique}; дубликатов: {duplicates}")


def add_links():
    print("Вставляйте VLESS-ссылки по одной на строку. Пустая строка завершает ввод.")
    added = []
    while True:
        try:
            raw = safe_input("vless> ").strip()
        except EOFError:
            break
        if not raw:
            break
        try:
            proto, host, port = summarize_uri(raw)
            info(f"принято: {proto}, {host}:{port}")
            added.append(raw)
        except Exception as exc:
            fail(str(exc))
    if not added:
        warn("ничего не добавлено")
        return
    lines = source_lines()
    existing = {x.strip() for x in lines if x.strip()}
    unique = [x for x in added if x not in existing]
    if not unique:
        warn("все ссылки уже присутствуют")
        return
    ensure_session_backup()
    backup = write_source(lines + unique)
    ok(f"добавлено ссылок: {len(unique)}; backup: {backup}")


def edit_link():
    list_links()
    number = int(safe_input("Номер строки для изменения: ").strip())
    lines = source_lines()
    if number < 1 or number > len(lines):
        raise ValueError("номер вне диапазона")
    raw = safe_input("Новая VLESS-ссылка: ").strip()
    proto, host, port = summarize_uri(raw)
    print(f"Будет сохранено: {proto}, {host}:{port}")
    if safe_input("Подтвердить изменение? [y/N]: ").strip().lower() not in {"y", "yes", "д", "да"}:
        warn("отменено")
        return
    ensure_session_backup()
    lines[number - 1] = raw
    backup = write_source(lines)
    ok(f"строка {number} изменена; backup: {backup}")


def delete_links():
    list_links()
    raw = safe_input("Номера строк через запятую: ").strip()
    numbers = sorted({int(x) for x in re.split(r"[ ,;]+", raw) if x}, reverse=True)
    lines = source_lines()
    if not numbers or any(x < 1 or x > len(lines) for x in numbers):
        raise ValueError("некорректные номера строк")
    print("Удаляются строки:", ", ".join(map(str, sorted(numbers))))
    if safe_input("Подтвердить удаление? [y/N]: ").strip().lower() not in {"y", "yes", "д", "да"}:
        warn("удаление отменено")
        return
    ensure_session_backup()
    for number in numbers:
        del lines[number - 1]
    backup = write_source(lines)
    ok(f"удалено ссылок: {len(numbers)}; backup: {backup}")


def curl_status(port, url, redirects=False):
    cmd = [
        "curl", "--noproxy", "", "--proxy", f"socks5h://127.0.0.1:{port}",
        "--http2", "--connect-timeout", "7", "--max-time", "20", "-sS",
        "-o", "/dev/null", "-w", "%{http_code}",
    ]
    if redirects:
        cmd += ["-L", "--max-redirs", "3"]
    result = run(cmd + [url], timeout=25)
    return result.stdout.strip() or f"curl:{result.returncode}"


def service_probe(port):
    chat_codes = [curl_status(port, CHATGPT_URL) for _ in range(2)]
    gemini_codes = [curl_status(port, GEMINI_URL, redirects=True) for _ in range(2)]
    chat = chat_codes == [EXPECTED_CHATGPT, EXPECTED_CHATGPT]
    gemini = gemini_codes == [EXPECTED_GEMINI, EXPECTED_GEMINI]
    detail = json.dumps({"chat": chat, "gemini": gemini, "chat_codes": chat_codes, "gemini_codes": gemini_codes})
    # probe_one retries when ChatGPT is unavailable; Gemini-only nodes are not useful fallback.
    return chat, detail


def test_nodes(save=True):
    heading("ПРОВЕРКА УЗЛОВ: CHATGPT + GEMINI")
    print("Критерии: ChatGPT Codex = HTTP 404 дважды; Gemini Web = HTTP 200 дважды.\n")
    core = load_core()
    native, xhttp, skipped = core.parse_links()
    raw_links = [x.strip() for x in source_lines() if x.strip() and not x.strip().startswith("#")]
    duplicate_count = len(raw_links) - len(set(raw_links))
    core.curl_chatgpt = service_probe
    tasks = []
    for index, item in enumerate(native):
        tasks.append(("native", item, core.PROBE_PORT_BASE + index))
    for index, item in enumerate(xhttp):
        tasks.append(("xhttp", item, core.PROBE_PORT_BASE + len(native) + index))
    with concurrent.futures.ThreadPoolExecutor(max_workers=min(4, max(1, len(tasks)))) as pool:
        raw_results = list(pool.map(core.probe_one, tasks))
    results = []
    for kind, item, _healthy, detail in sorted(raw_results, key=lambda x: x[1]["line"]):
        try:
            status = json.loads(detail)
        except json.JSONDecodeError:
            status = {"chat": False, "gemini": False, "chat_codes": [detail], "gemini_codes": ["not-tested"]}
        result = {
            "line": item["line"], "id": item["id"], "kind": kind,
            "protocol": protocol_name(item, kind), "server": item["server"],
            **status,
        }
        results.append(result)
        chat_mark = color("✓ OK", C_GREEN + C_BOLD) if result["chat"] else color("✗ " + "/".join(result["chat_codes"]), C_RED + C_BOLD)
        gemini_mark = color("✓ OK", C_GREEN + C_BOLD) if result["gemini"] else color("✗ " + "/".join(result["gemini_codes"]), C_RED + C_BOLD)
        print(f"строка {item['line']:>3} {result['protocol']:<13} ChatGPT={chat_mark:<9} Gemini={gemini_mark}")
    if skipped:
        for line, reason in skipped:
            fail(f"строка {line}: {reason}")
    both = [x for x in results if x["chat"] and x["gemini"]]
    chat = [x for x in results if x["chat"]]
    print("\n" + color("ИТОГ:", C_BOLD))
    print(f"  Оба сервиса:   {status_text(bool(both), str(len(both)) + '/' + str(len(results)), '0/' + str(len(results)))}")
    print(f"  ChatGPT:       {status_text(bool(chat), str(len(chat)) + '/' + str(len(results)), '0/' + str(len(results)))}")
    print(f"  Ошибки ссылок: {status_text(not skipped, '0', str(len(skipped)))}")
    print(f"  Дубликаты:     {color(str(duplicate_count), C_YELLOW if duplicate_count else C_GREEN)}")
    if save:
        ensure_session_backup()
        STATE_DIR.mkdir(parents=True, exist_ok=True)
        payload = {"tested_at": dt.datetime.now(dt.timezone.utc).isoformat(), "results": results, "skipped": skipped}
        RESULTS_FILE.write_text(json.dumps(payload, ensure_ascii=False, indent=2) + "\n")
        os.chmod(RESULTS_FILE, 0o600)
    return core, native, xhttp, results, skipped


def select_nodes(native, xhttp, results):
    by_id = {x["id"]: x for x in results}
    both_ids = {x["id"] for x in results if x["chat"] and x["gemini"]}
    chat_ids = {x["id"] for x in results if x["chat"]}
    selected_ids = both_ids if both_ids else chat_ids
    mode = "ChatGPT+Gemini" if both_ids else "только ChatGPT"
    selected_native = [x for x in native if x["id"] in selected_ids]
    selected_xhttp = [x for x in xhttp if x["id"] in selected_ids]
    return selected_native, selected_xhttp, mode


def apply_best(interactive=True):
    require_root()
    core, native, xhttp, results, skipped = test_nodes(save=True)
    selected_native, selected_xhttp, mode = select_nodes(native, xhttp, results)
    if not selected_native and not selected_xhttp:
        raise RuntimeError("нет узлов с доступом к ChatGPT; активный конфиг не изменён")
    print(f"\nРежим выбора: {mode}")
    print(f"Будет подключено: native={len(selected_native)}, XHTTP/TLS={len(selected_xhttp)}")
    if interactive and safe_input("Применить с резервной копией и автооткатом? [y/N]: ").strip().lower() not in {"y", "yes", "д", "да"}:
        warn("применение отменено")
        return
    sing, xray = core.build_configs(selected_native, selected_xhttp)
    with tempfile.TemporaryDirectory(prefix="vless-manager-check-") as tmp:
        sing_path = Path(tmp) / "sing.json"
        xray_path = Path(tmp) / "xray.json"
        core.write_json(sing_path, sing)
        core.write_json(xray_path, xray)
        core.validate(sing_path, xray_path, bool(selected_xhttp))
    ensure_session_backup()
    core.apply_configs(sing, xray, bool(selected_xhttp))
    verify_runtime(expected=len(selected_native) + len(selected_xhttp))
    ok(f"применено узлов: {len(selected_native) + len(selected_xhttp)}; политика: {mode}")


def command_exists(path):
    return Path(path).is_file() and os.access(path, os.X_OK)


def service_state(name):
    active = run(["systemctl", "is-active", name]).stdout.strip()
    enabled = run(["systemctl", "is-enabled", name]).stdout.strip()
    return active, enabled


def diagnostics(show_fixes=True):
    heading("ДИАГНОСТИКА VPN")
    issues = []
    print(f"sing-box: {short_version(['/usr/bin/sing-box', 'version'])}")
    print(f"Xray:     {short_version(['/usr/local/bin/xray-hermes', 'version'])}\n")
    checks = [
        ("sing-box", command_exists("/usr/bin/sing-box"), "установите пакет sing-box"),
        ("Xray", command_exists("/usr/local/bin/xray-hermes"), "установите Xray в /usr/local/bin/xray-hermes"),
        ("core-генератор", command_exists(str(CORE)), f"восстановите {CORE}"),
        ("файл ссылок", SOURCE.is_file(), f"install -o odmin -g odmin -m 600 /dev/null {SOURCE}"),
        ("sing-box config", SING_CONFIG.is_file(), "запустите пункт «Установить/исправить базовую конфигурацию»"),
        ("Xray config", XRAY_CONFIG.is_file(), "запустите пункт «Установить/исправить базовую конфигурацию»"),
        ("xray-hermes unit", XRAY_UNIT.is_file(), "запустите пункт «Установить/исправить базовую конфигурацию»"),
    ]
    for name, passed, fix in checks:
        (ok if passed else fail)(name)
        if not passed:
            issues.append((name, fix))
    for service in ("sing-box.service", "xray-hermes.service"):
        active, enabled = service_state(service)
        passed = active == "active" and enabled == "enabled"
        (ok if passed else fail)(f"{service}: active={active}, enabled={enabled}")
        if not passed:
            issues.append((service, f"systemctl enable --now {service}"))
    if command_exists("/usr/bin/sing-box") and SING_CONFIG.exists():
        result = run(["/usr/bin/sing-box", "check", "-c", str(SING_CONFIG)])
        (ok if result.returncode == 0 else fail)("синтаксис sing-box" + ("" if result.returncode == 0 else f": {result.stderr.strip()}"))
        if result.returncode:
            issues.append(("sing-box config", f"sing-box check -c {SING_CONFIG}"))
    if command_exists("/usr/local/bin/xray-hermes") and XRAY_CONFIG.exists():
        result = run(["/usr/local/bin/xray-hermes", "run", "-test", "-c", str(XRAY_CONFIG)])
        (ok if result.returncode == 0 else fail)("синтаксис Xray" + ("" if result.returncode == 0 else f": {result.stderr.strip()}"))
        if result.returncode:
            issues.append(("Xray config", f"/usr/local/bin/xray-hermes run -test -c {XRAY_CONFIG}"))
    codex = run(["curl", "--noproxy", "*", "--http2", "--connect-timeout", "7", "--max-time", "15", "-sS", "-o", "/dev/null", "-w", "%{http_code}", CHATGPT_URL]).stdout.strip()
    (ok if codex == EXPECTED_CHATGPT else fail)(f"Hermes Codex API: HTTP {codex}")
    if codex != EXPECTED_CHATGPT:
        issues.append(("Codex API", "journalctl -u sing-box -u xray-hermes -n 100 --no-pager"))
    gemini = run(["curl", "--noproxy", "*", "--http2", "-L", "--max-redirs", "3", "--connect-timeout", "7", "--max-time", "15", "-sS", "-o", "/dev/null", "-w", "%{http_code}", GEMINI_URL]).stdout.strip()
    (ok if gemini == EXPECTED_GEMINI else fail)(f"Gemini Web: HTTP {gemini}")
    if gemini != EXPECTED_GEMINI:
        issues.append(("Gemini/DNS", "resolvectl query gemini.google.com; journalctl -u sing-box -n 100 --no-pager"))
    if issues and show_fixes:
        print("\nКоманды/действия для исправления:")
        for name, fix in issues:
            print(f"- {name}: {fix}")
    return not issues


